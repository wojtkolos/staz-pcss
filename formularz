body {
    background-color: #f5f5f5;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: #333;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}


#container {
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    padding: 30px;
    width: 90%;
    max-width: 600px;
    margin: 20px;
    border: 1px solid #a29bfe;
}


form {
    display: flex;
    flex-direction: column;
}


label {
    margin-top: 10px;
    font-weight: bold;
    font-size: 16px;
    color: #6c5ce7;
}

input[type="text"],
input[type="email"],
input[type="tel"],
input[type="date"],
textarea {
    width: 100%;
    padding: 12px;
    margin-top: 5px;
    margin-bottom: 20px;
    border: 1px solid #a29bfe;
    border-radius: 8px;
    box-sizing: border-box;
    font-size: 16px;
    background-color: #ede7f6;
}

textarea {
    height: 120px;
    resize: vertical;
}


.radio-group {
    margin-top: 5px;
    margin-bottom: 20px;
}

.radio-group label {
    display: block;
    font-weight: normal;
    font-size: 16px;
    color: #333;
    margin-bottom: 10px;
}

.radio-group input[type="radio"] {
    margin-right: 10px;
    accent-color: #6c5ce7; 
}

input[type="checkbox"] {
    margin-right: 8px;
}

input[type="submit"] {
    background-color: #6c5ce7;
    color: #ffffff;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 18px;
    font-weight: bold;
    transition: background-color 0.3s ease;
}


input[type="submit"]:hover {
    background-color: #5e35b1;
}

span {
    font-size: 14px;
    color: #d32f2f;
    display: block;
    margin-top: -15px;
    margin-bottom: 10px;
}
